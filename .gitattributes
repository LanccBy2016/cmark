# 默认自动识别文本文件
* text=auto

# 源码统一 LF，避免跨平台 diff 噪音
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.cjs  text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.md   text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Windows 批处理必须是 CRLF，否则 cmd 解析出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制：禁止任何换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.asar  binary